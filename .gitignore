# Keep datasets and course materials local.
/data/
/processed_data/
/reference_modules/
/ptb-xl-a-comprehensive-electrocardiographic-feature-dataset-*/
*.zip

# Exclude generated reports and document working files.
/reports/
/models/*
!/models/tabm/
# TabM results are published; resumable binary checkpoints stay local.
/models/tabm/checkpoints/
/models/tabm/pilots/*/checkpoints/
/models/tabm/.run.lock
/models/tabm/pilots/*/.run.lock
/models/tabm/logs/
/models/tabm/pipeline_status.json
*.tmp
/tools/
/docs/reference/
/requirements-documents.txt

# Exclude local environments and caches.
/.runtime/
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
Thumbs.db
~$*
