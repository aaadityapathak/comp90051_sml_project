# Ignore additional datasets and course materials; existing tracked inputs remain.
/data/
/processed_data/
/reference_modules/
/ptb-xl-a-comprehensive-electrocardiographic-feature-dataset-*/
*.zip

# Exclude generated reports and document working files.
/reports/
/results/data_insights/
/results/imputation/
/results/comparison/evaluation/
/results/comparison/reports/
/notebooks/archive/
/notebooks/legacy/
# TabM results are published; resumable binary checkpoints stay local.
/results/tabm/checkpoints/
/results/tabm/pilots/*/checkpoints/
/results/**/checkpoints/
/results/**/worker_status/
/results/**/.run.lock
/results/**/logs/
/results/**/pipeline_status.json
*.tmp
/tools/
/docs/reference/
/requirements-documents.txt

# Exclude local environments and caches.
/.runtime/
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
Thumbs.db
~$*
